:8080 {
	root * /srv/app
	encode gzip zstd

	# This app ships no .wasm file (confirmed by find during the port — see
	# CLAUDE.md). The @wasm block is defensive/dead code, kept only for
	# consistency with the shared Caddyfile template, in case a future
	# version of this app adds one.
	@wasm path *.wasm
	header @wasm Content-Type "application/wasm"

	# PWA (vite-plugin-pwa, registerType: autoUpdate, added after the initial
	# port). sw.js/manifest.webmanifest/registerSW.js/`/` must never be
	# browser-cached, or a returning visitor's service worker won't notice a
	# new deploy exists — verified end-to-end with curl (see CLAUDE.md).
	@nocache path / /index.html /sw.js /manifest.webmanifest /registerSW.js
	header @nocache Cache-Control "no-cache"

	# Vite's hashed /assets/* AND vite-plugin-pwa's own hashed workbox
	# runtime chunk (workbox-<hash>.js, lives at the repo root, not under
	# /assets/) are both safe to cache for a year — both filenames change
	# whenever their content does. Found by curling the real built output:
	# without the /workbox-*.js pattern here, that file got no Cache-Control
	# header at all (fell through both matchers), unlike every other hashed
	# asset.
	@immutable path /assets/* /workbox-*.js
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Caddy's `path` matcher operates on the request path as given, while
	# `try_files` resolves against the filesystem including the SPA fallback —
	# matching {path} first is required for the two header blocks above to
	# actually apply before the fallback rewrites everything to /index.html.
	try_files {path} /index.html
	file_server

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
